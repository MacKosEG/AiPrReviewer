@@ -0,0 +1,36 @@
+import { describe, expect, it } from 'vitest';
+import { isSlug, slugify } from './slugify';
+
+describe('slugify', () => {
+  it('lowercases and joins words with dashes', () => {
+    expect(slugify('Hello, World!')).toBe('hello-world');
+  });
+
+  it('removes diacritics', () => {
+    expect(slugify('Crème brûlée à la carte')).toBe('creme-brulee-a-la-carte');
+  });
+
+  it('trims leading and trailing separators', () => {
+    expect(slugify('  --Already slugged--  ')).toBe('already-slugged');
+  });
+
+  it('returns an empty string for input without letters or digits', () => {
+    expect(slugify('!!!')).toBe('');
+  });
+
+  it('caps the length without leaving a trailing dash', () => {
+    expect(slugify('one two three', 8)).toBe('one-two');
+  });
+
+  it('rejects a non-positive maxLength', () => {
+    expect(() => slugify('x', 0)).toThrow(RangeError);
+  });
+});
+
+describe('isSlug', () => {
+  it('accepts slugs and rejects other strings', () => {
+    expect(isSlug('hello-world')).toBe(true);
+    expect(isSlug('Hello World')).toBe(false);
+    expect(isSlug('trailing-')).toBe(false);
+  });
+});
