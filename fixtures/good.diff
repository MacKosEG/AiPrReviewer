+import request from 'supertest';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import { app } from '../../src/app';
+import { articlesRepo } from '../../src/db/articles';
+
+vi.mock('../../src/db/articles', () => ({
+  articlesRepo: { create: vi.fn(async (data: object) => ({ id: 1, ...data })) },
+}));
+
+beforeEach(() => vi.mocked(articlesRepo.create).mockClear());
+
+describe('POST /articles', () => {
+  it('stores the slug derived from the title', async () => {
+    const res = await request(app).post('/articles').send({ title: 'Hello, World!', body: 'Hi' });
+    expect(res.status).toBe(201);
+    expect(res.body.slug).toBe('hello-world');
+    expect(articlesRepo.create).toHaveBeenCalledWith(expect.objectContaining({ slug: 'hello-world' }));
+  });
+
+  it('rejects titles without letters or digits', async () => {
+    const res = await request(app).post('/articles').send({ title: '!!!', body: 'Hi' });
+    expect(res.status).toBe(400);
+    expect(articlesRepo.create).not.toHaveBeenCalled();
+  });
+});
+
