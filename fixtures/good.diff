+/**
+ * Converts a title into a URL-safe slug, e.g. "Hello, World!" -> "hello-world".
+ * Diacritics are removed and the result is capped at `maxLength` characters.
+ */
+export function slugify(title: string, maxLength = 80): string {
+  if (maxLength <= 0) {
+    throw new RangeError('maxLength must be positive');
+  }
+  const slug = title
+    .normalize('NFKD')
+    .replace(/[̀-ͯ]/g, '')
+    .toLowerCase()
+    .replace(/[^a-z0-9]+/g, '-')
+    .replace(/^-+|-+$/g, '');
+
+  return slug.slice(0, maxLength).replace(/-+$/, '');
+}
+
+export const isSlug = (value: string): boolean => /^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(value);
+
